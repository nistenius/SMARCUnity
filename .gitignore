# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*


.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# Common IntelliJ Platform excludes

# User specific
**/.idea/**/workspace.xml
**/.idea/**/tasks.xml
**/.idea/shelf/*
**/.idea/dictionaries
**/.idea/httpRequests/

# Sensitive or high-churn files
**/.idea/**/dataSources/
**/.idea/**/dataSources.ids
**/.idea/**/dataSources.xml
**/.idea/**/dataSources.local.xml
**/.idea/**/sqlDataSources.xml
**/.idea/**/dynamic.xml

# Rider
# Rider auto-generates .iml files, and contentModel.xml
**/.idea/**/*.iml
**/.idea/**/contentModel.xml
**/.idea/**/modules.xml
.idea
*.idea


*.suo
*.user
.vs/
[Bb]in/
[Oo]bj/
_UpgradeReport_Files/

.gitignore.bak
.vsconfig
.vscode/

Thumbs.db
Desktop.ini
.DS_Store

Assets/TextMesh\ Pro/
Assets/TextMesh\ Pro.meta
Assets/msgbrowser_settings.asset*

# SAM replay + one-DOF rig DATA (2026-09-12). ~38 MB of tank-recording CSVs and generated
# run outputs. The CSVs come from the tank bags (see data-cube/docs/2026-09-11-sam-tank-
# sysid-data-and-tuning-plan.md); the reports/CSVs under dof/ are written by SAMDofTest on
# every run. Only dof/config.txt - the run input - is tracked.
Assets/StreamingAssets/SAMReplay/*.csv
Assets/StreamingAssets/SAMReplay/*.csv.meta
Assets/StreamingAssets/SAMReplay/out/
Assets/StreamingAssets/SAMReplay/out.meta
Assets/StreamingAssets/SAMReplay/dof/*.csv
Assets/StreamingAssets/SAMReplay/dof/*.csv.meta
Assets/StreamingAssets/SAMReplay/dof/*_summary.txt
Assets/StreamingAssets/SAMReplay/dof/*_summary.txt.meta
Assets/StreamingAssets/SAMReplay/dof/trim_report.txt*
Assets/StreamingAssets/SAMReplay/dof/rig_report.txt*
Assets/StreamingAssets/SAMReplay/dof/force_report.txt*

# Unity crash-recovery scenes and editor backups
Assets/_Recovery/
Assets/_Recovery.meta
Assets/Scenes/*.BACKUP-*.unity.txt*

# Data Cube replay JSON (8.5 MB, generated Aug 2026 from rosbags by the replay exporter)
Assets/StreamingAssets/DataCubeReplays/
Assets/StreamingAssets/DataCubeReplays.meta
